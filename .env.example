# Copie este arquivo para .env e ajuste os valores.
# .env NAO deve ser commitado (contem segredos) - ja esta no .gitignore.

# UID do usuario do host, usado pelos containers do Airflow para permissao de arquivos.
# No Linux, rode `id -u` e use o valor retornado. No macOS/Windows (Docker Desktop) pode manter 50000.
AIRFLOW_UID=50000

# Credenciais do usuario admin criado na UI do Airflow (login em http://localhost:8080).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Credenciais da API do Kaggle, usadas pela DAG kaggle_wisdm_to_s3 para baixar o dataset.
# Gerar em https://www.kaggle.com/settings -> API -> Create New Token (baixa um kaggle.json
# com esses dois valores).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Credenciais AWS usadas pela DAG kaggle_wisdm_to_s3 para enviar os arquivos ao S3
# (raw layer da arquitetura medalhao).
# Se estiver usando AWS Academy Learner Lab (sandbox com IAM restrito): pegue as 3
# credenciais em "AWS Details" na pagina do lab (sao temporarias, expiram quando o
# lab reinicia - AWS_SESSION_TOKEN e obrigatorio nesse caso).
# Se estiver usando uma conta AWS normal: crie um usuario/role IAM com permissao
# apenas de escrita no bucket abaixo e deixe AWS_SESSION_TOKEN em branco.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Bucket S3 (ja existente) e prefixo onde os arquivos raw (bronze) do dataset serao gravados.
# Sufixo -wisdm de proposito, para poder coexistir na mesma conta com o bucket
# do projeto anterior (WESAD).
S3_BUCKET_NAME=
S3_RAW_PREFIX=raw/wisdm

# Camada silver (arquitetura medalhao): prefixo onde a DAG wisdm_bronze_to_silver
# grava as features tabulares extraidas (Parquet, particionado por subject), e
# configuracao do Glue Data Catalog / Athena, usados como substituto do Snowflake
# neste ambiente sandbox (autorizado pelo professor). O dbt (staging + marts)
# le/escreve nesse banco Glue.
S3_SILVER_PREFIX=silver/wisdm_features
GLUE_DATABASE_NAME=projeto_integrado_wisdm_silver

# Camada gold: banco Glue PROPRIO (separado do da silver), para manter cada
# camada da medalhao em seu proprio schema/database no Data Catalog. O dbt
# cria esse banco sozinho na primeira vez que materializa um model gold
# (dbt-athena chama Glue CreateDatabase se o schema alvo nao existir) - nao
# precisa ser criado manualmente antes.
GOLD_GLUE_DATABASE_NAME=projeto_integrado_wisdm_gold

# Workgroup do Athena a usar; "primary" existe por padrao em qualquer conta/sandbox.
ATHENA_WORKGROUP=primary
# Prefixo (no mesmo S3_BUCKET_NAME) onde o Athena grava os resultados/metadados de query.
ATHENA_RESULTS_PREFIX=athena-results

# Credenciais do admin criado automaticamente no Metabase no primeiro boot
# (container metabase-init chama a API de setup - sem passar pela tela de
# onboarding manual) e ja conecta o Metabase ao banco Gold via Athena.
METABASE_ADMIN_EMAIL=admin@projeto-integrado.local
METABASE_ADMIN_PASSWORD=
METABASE_SITE_NAME="Projeto Integrado WISDM"

# Chave de criptografia usada pelo Airflow para connections/variables (obrigatoria).
# Gerar com:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=

# Segredo usado para assinar os JWT da API interna do Airflow 3+ (obrigatorio).
# Gerar com:
#   openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=
