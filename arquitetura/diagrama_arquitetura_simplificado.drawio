        <mxCell id="title" value="Arquitetura real do pipeline WISDM — o que está implementado hoje" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Orquestração e apresentação rodam localmente via Docker Compose (Airflow, Jupyter, Metabase); armazenamento, catálogo e consulta já são AWS real (S3, Glue Data Catalog, Athena — dbt roda em cima do Athena). A evolução para serviços 100% gerenciados é só uma nota ao final, não o foco deste diagrama." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#767676;align=left;verticalAlign=middle;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="34" width="1120" height="42" as="geometry" />
